# Rename/copy to frontend/.env.production when building locally.
# Do not commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Leave empty so browser uses /api/hms (proxied to Railway by the Worker)
# NEXT_PUBLIC_API_BASE_URL=

HMS_INTERNAL_API_BASE_URL=https://hms-ai-assistant-production.up.railway.app
