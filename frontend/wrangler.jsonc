{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "donexto-app",
	"compatibility_date": "2026-07-29",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"vars": {
		// Server-side proxy target for /api/hms/* → Railway FastAPI.
		// scripts/deploy-worker.mjs also injects NEXT_PUBLIC_SUPABASE_* for
		// this deploy only. nodejs_compat reads Worker vars as process.env;
		// without them an un-inlined bundle throws during SSR and `/` is HTTP 500.
		"HMS_INTERNAL_API_BASE_URL": "https://hms-ai-assistant-production.up.railway.app"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "donexto-app"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
	// No "routes" here. app.donexto.com is a dashboard custom domain.
	// Path routes for www.donexto.com/admin* and the apex are applied by
	// scripts/configure-admin-routes.mjs so deploy does not drop that domain.
	// See docs/ops/ADMIN_EN_WWW.md.
}